    }
  jpeg_info->client_data=(void *) client_info;'''

    clean_code = filter_comments(raw_code)
    all_funcs, func_body_dict = identify_functions(clean_code)
    print(f"[DEBUG] Parsed functions: {list(func_body_dict.keys())}")

    entry_points = ["ReadOneJPEGImage"]
    exec_flow = build_execution_flow(func_body_dict, entry_points)

    all_features = []
    for func_name, line in exec_flow:
        free_op = extract_free(line)
        if free_op:
            all_features.append(free_op)
        else:
            mallocs = extract_malloc(line)
            all_features.extend(mallocs)
            if not mallocs:
                uses = extract_use_vars(line)
                all_features.extend(uses)


    filtered_features = []
    prev = None
    for feat in all_features:
        if feat != prev:
            filtered_features.append(feat)
            prev = feat

    print("\n=== Filtered Memory Timeline ===")
    for idx, f in enumerate(filtered_features, 1):
        print(f"{idx:2d}. {f}")


    print("\n=== UAF Detection Result ===")
    freed_vars = set()
    uaf_found = False
    for feat in filtered_features:
        parts = feat.split()
        if len(parts) < 2:
            continue
        act, var = parts[0], parts[1]
        if act == "free":
            freed_vars.add(var)
        elif act == "use" and var in freed_vars:
            print(f"⚠️  UAF DETECTED! Variable '{var}' (id={VAR_ID_MAP[var]}) used after being freed")
            uaf_found = True
    if not uaf_found:
        print("✅ No UAF detected")

    if filtered_features:
        draw_uaf_flow(filtered_features)
    else:
        print("undetected")


if __name__ == "__main__":
    main()

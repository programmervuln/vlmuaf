import re
import matplotlib.pyplot as plt

VAR_ID_MAP = {
    "client_info": 1
}


def filter_comments(text):
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
    text = re.sub(r"//.*?$", "", text, flags=re.MULTILINE)
    return text


def identify_functions(code):
    funcs = []
    pat = r'(void|int|char|float|double|struct|Image|ssize_t|MemoryInfo|JPEGClientInfo|StringInfo)\s*\*?\s*([A-Za-z_]\w*)\s*\([^)]*\)'
    for m in re.finditer(pat, code):
        func_name = m.group(2)
        after_header_pos = m.end()
        brace_start = code.find("{", after_header_pos)
        if brace_start == -1:
            continue
        start_idx = brace_start + 1
        funcs.append({"name": func_name, "start": start_idx})

    func_body_map = {}
    for f in funcs:
        pos = f["start"]
        brace = 1
        while pos < len(code) and brace > 0:
            if code[pos] == '{':
                brace += 1
            elif code[pos] == '}':
                brace -= 1
            pos += 1
        body = code[f["start"]:pos-1]
        func_body_map[f["name"]] = body
    return funcs, func_body_map


def build_execution_flow(func_body_map, entry_list):
    exec_list = []
    visited_func = set()

    def dfs(func_name):
        if func_name not in func_body_map or func_name in visited_func:
            return
        visited_func.add(func_name)
        body = func_body_map[func_name]
        lines = body.splitlines()
        for raw_line in lines:
            line = raw_line.strip()
            if not line:
                continue
            exec_list.append((func_name, line))
            calls = set(re.findall(r"\b([A-Za-z_]\w+)\s*\(", line))

            if "JPEGCleanup(" in line:
                m = re.search(r'JPEGCleanup\s*\(\s*[^,]+,\s*([\w]+)\s*\)', line)
                if m:
                    free_var = m.group(1)
                    exec_list.append(("[sim]JPEGCleanup", f"virtual_free {free_var}"))

            for callee in calls:
                if callee not in visited_func:
                    dfs(callee)

    for entry in entry_list:
        dfs(entry)
    return exec_list


def extract_malloc(line):
    pat = r"([A-Za-z_]\w+)\s*=\s*(?:\([^)]+\)\s*)?AcquireMagickMemory\s*\("
    res = []
    for m in re.findall(pat, line):
        var = m
        res.append(f"malloc {var}")
    return res


def extract_free(line):
    virt_match = re.search(r'virtual_free\s+(\w+)', line)
    if virt_match:
        v_name = virt_match.group(1)
        return f"free {v_name}"

    pat = r"(RelinquishMagickMemory|DestroyStringInfo|free|kfree|kvfree)\s*\(\s*([\w>[\]]+)\s*\)"
    match = re.search(pat, line)
    if match:
        v_name = match.group(2)
        return f"free {v_name}"
    return None


def extract_use_vars(line):

    use_feats = []
    var_pat = r"\b([A-Za-z_]\w+(?:->|\.[A-Za-z_]\w+)*(?:\[\d*\])?)\b"
    all_matches = re.findall(var_pat, line)
    unique_vars = set()
    for full_expr in all_matches:
        base_var = re.split(r"->|\.", full_expr)[0]
        if base_var in VAR_ID_MAP:
            unique_vars.add(base_var)
    for v in unique_vars:
        use_feats.append(f"use {v}")
    return use_feats


def draw_uaf_flow(feature_list):
    plt.figure(figsize=(16, 6))
    pos_map = {}
    shape_map = {}
    text_map = {}
    idx = 0

    for feat in feature_list:
        parts = feat.split()
        if len(parts) < 2:
            continue
        act, var = parts[0], parts[1]
        if var not in VAR_ID_MAP:
            continue
        if act == "malloc":
            shape = "circle"
        elif act == "free":
            shape = "triangle"
        elif act == "use":
            shape = "square"
        else:
            continue
        pos_map[idx] = (idx * 2, 0)
        shape_map[idx] = shape
        text_map[idx] = VAR_ID_MAP[var]
        idx += 1

    ax = plt.gca()
    for i in range(len(pos_map)):
        x, y = pos_map[i]
        s = shape_map[i]
        num = text_map[i]
        if s == "circle":
            circ = plt.Circle((x, y), 0.5, fc="lightcoral", ec="black")
            ax.add_patch(circ)
        elif s == "triangle":
            poly = plt.Polygon(
                [[x - 0.5, y - 0.5], [x + 0.5, y - 0.5], [x, y + 0.5]],
                fc="lightgreen", ec="black"
            )
            ax.add_patch(poly)
        elif s == "square":
            rect = plt.Rectangle((x - 0.5, y - 0.5), 1, 1, fc="lightblue", ec="black")
            ax.add_patch(rect)
        plt.text(x, y, str(num), ha="center", va="center", fontsize=12)

    plt.xlim(-1, len(pos_map) * 2)
    plt.ylim(-1, 1)
    plt.axis("off")
    plt.title("ImageMagick ReadOneJPEGImage UAF: Memory Sequence (client_info=1)")
    plt.tight_layout()
    plt.savefig("imagemagick_uaf_same_style.png", dpi=300, bbox_inches="tight")
    plt.show()
    plt.close()
    print("\n✅ saved to: imagemagick_uaf_same_style.png")


def main():
    raw_code = '''
     client_info=(JPEGClientInfo *) RelinquishMagickMemory(client_info);
    }
  jpeg_destroy_decompress(jpeg_info);
  return(client_info);
}

static void JPEGDestroyImageProfiles(JPEGClientInfo *client_info)
{
  ssize_t
    i;

  StringInfo
    *profile;

  for (i=0; i < MaxJPEGProfiles; i++)
  {
    profile=client_info->profiles[i];
    if (profile == (StringInfo *) NULL)
      continue;
    client_info->profiles[i]=DestroyStringInfo(client_info->profiles[i]);
  }
}


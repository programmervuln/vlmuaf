def extract_uaf_features(use_lines):
    """
    Extract UAF-related use features from use operation lines.
    Args:
        use_lines (list): Formatted use operation strings
    Returns:
        list: Standardized use features (e.g., "use data1 (line 5)")
    """
    uaf_features = []
    variable_map = {}
    data_counter = 1

    for line in use_lines:
        # Match pattern: "use dataX (line N)" or "use var (line N)"
        match = re.match(r"use\s+([\w\d]+)\s*\(line\s+(\d+)\)", line)
        if match:
            var_name = match.group(1)
            line_num = match.group(2)

            if var_name not in variable_map:
                variable_map[var_name] = f"data{data_counter}"
                data_counter += 1

            uaf_features.append(f"use {variable_map[var_name]} (line {line_num})")

    return uaf_features



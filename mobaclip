    meta_root = '/zhangliqiang/clip/copyfolder/vlm0/pdg_data/meta'
    genchange_root = '/zhangliqiang/clip/copyfolder/vlm0/genchangename'
    save_dir = './uafvlm_models'

    # ---------- Device ----------
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    logger.info(f"Using device: {device}")

    # ---------- Load CLIP ----------
    try:
        clip_model = CLIPModel.from_pretrained('/zhangliqiang/clip/copyfolder/vlm0/clip-model').to(device)
        clip_processor = CLIPProcessor.from_pretrained('/zhangliqiang/clip/copyfolder/vlm0/clip-model')
        logger.info("Loaded local CLIP model.")
    except:
        logger.warning("Local CLIP not found, downloading from HuggingFace...")
        clip_model = CLIPModel.from_pretrained("openai/clip-vit-base-patch32").to(device)
        clip_processor = CLIPProcessor.from_pretrained("openai/clip-vit-base-patch32")

    # ---------- Data preprocessing ----------
    preprocess = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.48145466, 0.4578275, 0.40821073],
                             std=[0.26862954, 0.26130258, 0.27577711])
    ])

    # ---------- Dataset & DataLoader ----------
    train_dataset = UAFDataset(
        img_root=img_root,
        meta_root=meta_root,
        genchange_root=genchange_root,
        is_train=True,
        preprocess=preprocess,
        clip_processor=clip_processor,
        max_len=4096
    )
    train_loader = DataLoader(train_dataset, batch_size=2, shuffle=True, num_workers=4, pin_memory=True)

    # ---------- Model, loss, optimizer ----------
    model = UAFVLM(clip_model=clip_model, embed_dim=768).to(device)
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-5)

    # ---------- Train ----------
    train_model(model, train_loader, optimizer, criterion, device, epochs=10, save_dir=save_dir)
    logger.info("Training finished.")

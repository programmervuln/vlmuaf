def extract_data_copy_features(code, unwanted_keywords):
    """
    Extract data copying operations AND pointer aliases (paper's trapezoid feature).
    Updated to prioritize pointer aliases (core UAF requirement) over data copies.
    Returns: list: Formatted copy/alias operation strings
    """
    copy_alias_features = []

    for line_num, line in enumerate(code.splitlines(), 1):
        stripped_line = line.strip()
        if not stripped_line:
            continue

        # Step 1: Check for pointer aliases FIRST (trapezoid priority)
        alias_str = track_pointer_aliases(stripped_line, unwanted_keywords)
        if alias_str:
            copy_alias_features.append(f"{alias_str} (line {line_num})")
            continue  # Skip data copy if alias is found

        # Step 2: Original data copy detection (preserved unchanged)
        copy_patterns = [
            # Direct copy: var2 = var1
            r'(\w+)\s*=\s*(\w+)\s*;',
            # Pointer copy: *var2 = *var1
            r'\*(\w+)\s*=\s*\*(\w+)\s*;',
            # Struct member copy: var2->mem = var1->mem or var2.mem = var1.mem
            r'(\w+)(?:->|\.)(\w+)\s*=\s*(\w+)(?:->|\.)\2\s*;'
        ]

        for pattern in copy_patterns:
            matches = re.findall(pattern, stripped_line)
            for match in matches:
                if len(match) == 2:
                    dest_var, src_var = match[0], match[1]
                    if dest_var not in unwanted_keywords and src_var not in unwanted_keywords:
                        copy_alias_features.append(f"copy {src_var} -> {dest_var} (line {line_num})")
                elif len(match) == 3:
                    dest_var, mem, src_var = match[0], match[1], match[2]
                    if dest_var not in unwanted_keywords and src_var not in unwanted_keywords:
                        copy_alias_features.append(f"copy {src_var}->{mem} -> {dest_var}->{mem} (line {line_num})")

    return copy_alias_features


def draw_graph(used_varlist):
    """
    Draw visual features diagram as per paper's Fig. 3 (ORIGINAL LOGIC PRESERVED):
    - Ellipse (Circle): Memory allocation (malloc)
    - Rectangle: Memory usage (use)
    - Triangle: Memory deallocation (free)
    - Trapezoid: Pointer Alias (NEW) / Data Copy (ORIGINAL)
    Updated to render trapezoids for both aliases and copies (matching your figure)
    """
    plt.figure(figsize=(12, 8))
    ax = plt.gca()
    ax.set_xlim(-1, len(used_varlist) * 2.5)
    ax.set_ylim(-2, 2)
    ax.axis('off')

    # Track variable IDs for consistent labeling (ORIGINAL)
    variable_id_map = {}
    next_var_id = 1

    for idx, op in enumerate(used_varlist):
        x_pos = idx * 2.5
        y_pos = 0

        # Parse operation type and variables (ORIGINAL + alias support)
        if op.startswith("malloc"):
            # Ellipse (Circle) for allocation (ORIGINAL)
            var_name = op.split()[1] if len(op.split()) > 1 else f"ptr{next_var_id}"
            if var_name not in variable_id_map:
                variable_id_map[var_name] = next_var_id
                next_var_id += 1
            var_id = variable_id_map[var_name]

            circle = Circle((x_pos, y_pos), 0.5, facecolor='lightcoral', edgecolor='black', linewidth=1.5)
            ax.add_patch(circle)
            ax.text(x_pos, y_pos, f"malloc\nvar{var_id}", ha='center', va='center', fontsize=9, fontweight='bold')

        elif op.startswith("use"):
            # Rectangle for memory usage (ORIGINAL)
            parts = op.split()
            data_id = parts[1] if len(parts) > 1 else f"data{next_var_id}"
            if data_id not in variable_id_map:
                variable_id_map[data_id] = next_var_id
                next_var_id += 1
            var_id = variable_id_map[data_id]

            rect = Rectangle((x_pos - 0.6, y_pos - 0.4), 1.2, 0.8, facecolor='lightblue', edgecolor='black',
                             linewidth=1.5)
            ax.add_patch(rect)
            ax.text(x_pos, y_pos, f"use\n{data_id}", ha='center', va='center', fontsize=9, fontweight='bold')

        elif op.startswith("free"):
            # Triangle for deallocation (ORIGINAL)
            var_name = op.split()[1] if len(op.split()) > 1 else f"ptr{next_var_id}"
            if var_name not in variable_id_map:
                variable_id_map[var_name] = next_var_id
                next_var_id += 1
            var_id = variable_id_map[var_name]

            # Triangle vertices: bottom-left, bottom-right, top-middle
            triangle = Polygon([(x_pos - 0.6, y_pos - 0.4), (x_pos + 0.6, y_pos - 0.4), (x_pos, y_pos + 0.4)],
                               facecolor='lightgreen', edgecolor='black', linewidth=1.5)
            ax.add_patch(triangle)
            ax.text(x_pos, y_pos - 0.1, f"free\nvar{var_id}", ha='center', va='center', fontsize=9, fontweight='bold')

        elif op.startswith("copy") or op.startswith("alias"):
            # Trapezoid for BOTH data copy (ORIGINAL) and pointer alias (NEW)
            # Parse copy/alias pattern: "copy/alias src -> dest (line N)"
            copy_match = re.search(r'(copy|alias)\s+([\w->]+)\s+->\s+([\w->]+)', op)
            if copy_match:
                op_type = copy_match.group(1)
                src = copy_match.group(2)
                dest = copy_match.group(3)

                # Assign IDs to source and destination (ORIGINAL logic)
                for var in [src, dest]:
                    if var not in variable_id_map:
                        variable_id_map[var] = next_var_id
                        next_var_id += 1
                src_id = variable_id_map[src]
                dest_id = variable_id_map[dest]

                # Trapezoid rendering (EXACTLY LIKE YOUR FIGURE)
                # Narrow top, wide bottom (matches your attached trapezoid style)
                trapezoid = Trapezoid(
                    xy=(x_pos - 0.8, y_pos - 0.3),  # Bottom-left corner
                    width=1.6,  # Bottom base width (wide)
                    height=0.6,  # Height of trapezoid
                    angle=15,  # Taper angle (narrow top)
                    facecolor='lightyellow' if op_type == 'copy' else 'ivory',  # Distinguish alias/copy
                    edgecolor='black',
                    linewidth=1.5
                )
                ax.add_patch(trapezoid)

                # Labeling (matches your figure's numbering: e.g., 3→23)
                label_text = f"alias\n{src_id}→{dest_id}" if op_type == 'alias' else f"copy\n{src_id}→{dest_id}"
                ax.text(x_pos, y_pos, label_text, ha='center', va='center', fontsize=8, fontweight='bold')

        # Add operation sequence label (ORIGINAL)
        ax.text(x_pos, y_pos - 1.2, f"Step {idx + 1}", ha='center', va='center', fontsize=8, color='gray')

    # Add legend (UPDATED with alias support)
    legend_elements = [
        Circle((0, 0), 0.1, facecolor='lightcoral', edgecolor='black', label='Allocation (malloc)'),
        Rectangle((0, 0), 0.2, 0.15, facecolor='lightblue', edgecolor='black', label='Usage (use)'),
        Polygon([(0, 0), (0.2, 0), (0.1, 0.15)], facecolor='lightgreen', edgecolor='black',
                label='Deallocation (free)'),
        Trapezoid((0, 0), 0.2, 0.15, 0.1, facecolor='lightyellow', edgecolor='black', label='Data Copy (copy)'),
        Trapezoid((0, 0), 0.2, 0.15, 0.1, facecolor='ivory', edgecolor='black', label='Pointer Alias (alias)')
    ]
    ax.legend(handles=legend_elements, loc='upper center', bbox_to_anchor=(0.5, -0.05), ncol=5, fontsize=10)

    plt.title('Static Analysis Visual Features (with Pointer Aliasing for UAF)', fontsize=14, fontweight='bold', pad=20)
    plt.tight_layout()
    plt.show()


def extract_uaf_features(use_lines):
    """
    Extract UAF-related use features from use operation lines.
    Args:
        use_lines (list): Formatted use operation strings
    Returns:
        list: Standardized use features (e.g., "use data1 (line 5)")
    """
    uaf_features = []
    variable_map = {}
    data_counter = 1

    for line in use_lines:
        # Match pattern: "use dataX (line N)" or "use var (line N)"
        match = re.match(r"use\s+([\w\d]+)\s*\(line\s+(\d+)\)", line)
        if match:
            var_name = match.group(1)
            line_num = match.group(2)

            if var_name not in variable_map:
                variable_map[var_name] = f"data{data_counter}"
                data_counter += 1

            uaf_features.append(f"use {variable_map[var_name]} (line {line_num})")

    return uaf_features



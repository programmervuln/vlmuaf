def split_c_code_by_semicolon_and_braces(code):
    """
    Split C code by semicolons, curly braces, and preserve #include statements.
    Returns a list of independent code statements.
    """
    # Split preprocessor statements (#include) while preserving them
    preprocessor_statements = re.split(r'(\#include\s*<.*?>)', code)

    combined_statements = []
    for part in preprocessor_statements:
        if not part.strip():
            continue

        if re.match(r'\#include\s*<.*?>', part):  # Preserve #include statements
            combined_statements.append(part.strip())
        else:
            # Split remaining code by ;, {, } while preserving delimiters
            statements = re.split(r'([;{}])', part)
            current_statement = ""
            for stmt in statements:
                current_statement += stmt.strip()
                if stmt in ';{}':  # Finalize statement at delimiters
                    if current_statement.strip():
                        combined_statements.append(current_statement.strip())
                    current_statement = ""

            # Add remaining content if any
            if current_statement.strip():
                combined_statements.append(current_statement.strip())

    return combined_statements


def filter_comments(text):
    """
    Remove C-style comments (/* ... */ and // ...) from code.
    Args:
        text (str): Raw C code
    Returns:
        str: Code with comments removed
    """
    pattern = r"/\*.*?\*/|//.*?$"
    filtered_text = re.sub(pattern, "", text, flags=re.DOTALL | re.MULTILINE)
    return filtered_text


def identify_functions(code):
    """
    Identify function definitions in C code.
    Args:
        code (str): Filtered C code (no comments)
    Returns:
        list: Dictionary of function details (name, return type, parameters, body start position)
    """
    functions = []
    # Regex pattern to match function definitions (supports common return types)
    pattern = r'(void|int|char|float|double|struct|long|short|unsigned|signed)\s+([A-Za-z_]\w*)\s*\(([^()]*)\)\s*\{'
    matches = re.finditer(pattern, code)

    for match in matches:
        return_type = match.group(1)
        function_name = match.group(2)
        parameters = [param.strip() for param in match.group(3).split(',')] if match.group(3).strip() else []
        functions.append({
            'function_name': function_name,
            'return_type': return_type,
            'parameters': parameters,
            'body_start': match.end()
        })
    return functions


def extract_function_body(code, start_pos):
    """
    Extract the body of a function from code using brace matching.
    Args:
        code (str): Filtered C code
        start_pos (int): Position right after the function's opening brace
    Returns:
        str: Function body content (without outer braces)
    """
    open_braces = 1
    current_pos = start_pos
    while open_braces > 0 and current_pos < len(code):
        if code[current_pos] == '{':
            open_braces += 1
        elif code[current_pos] == '}':
            open_braces -= 1
        current_pos += 1
    return code[start_pos:current_pos - 1]


def extract_execution_sequence(code, functions, current_function="main"):
    """
    Extract line-by-line execution sequence starting from the main function.
    Recursively resolves nested function calls.
    Args:
        code (str): Filtered C code
        functions (list): Function details from identify_functions()
        current_function (str): Function to start execution from
    Returns:
        list: Ordered execution sequence of code lines
    """
    execution_sequence = []

    def execute_line_by_line(func_name):
        nonlocal execution_sequence

        # Find target function and its body
        target_func = next((f for f in functions if f['function_name'] == func_name), None)
        if not target_func:
            return

        func_body = extract_function_body(code, target_func['body_start'])
        # Add each non-empty line to execution sequence
        for line in func_body.splitlines():
            stripped_line = line.strip()
            if stripped_line:
                execution_sequence.append(stripped_line)
                # Recursively execute nested function calls
                for f in functions:
                    if re.search(r'\b' + f['function_name'] + r'\b\s*\(', stripped_line):
                        execute_line_by_line(f['function_name'])

    execute_line_by_line(current_function)
    return execution_sequence


def find_variable_definitions(code_lines):
    """
    Identify variable and struct definitions in code lines.
    Args:
        code_lines (list): List of code lines (split by newline)
    Returns:
        tuple: (set of defined variable/struct names, list of (line_num, line_content))
    """
    defined_vars = set()
    defined_lines = []

    \  # Regex patterns for variable and struct definitions (FIXED: removed stray backslash)
    variable_pattern = re.compile(
        r'\b(?:int|float|double|char|void|long|short|unsigned|signed)\s+(\*?\s*\w+)(\s*=\s*[^;]*)?;?'
    )
    struct_pattern = re.compile(r'\bstruct\s+(\w+)\s+\w+\s*{')

    for line_num, line in enumerate(code_lines, 1):
        stripped_line = line.strip()

        \  # Match basic variable definitions (FIXED: removed stray backslash)
        var_matches = variable_pattern.findall(stripped_line)
        if var_matches:
            defined_lines.append((line_num, stripped_line))
            for match in var_matches:
                var_name = match[0].strip().replace('*',
                                                    '').strip()  \  # Remove pointer symbols (FIXED: removed backslash)
                defined_vars.add(var_name)

        \  # Match struct definitions (FIXED: removed stray backslash)
        struct_matches = struct_pattern.findall(stripped_line)
        if struct_matches:
            defined_lines.append((line_num, stripped_line))
            for struct_name in struct_matches:
                defined_vars.add(struct_name.strip())

    return defined_vars, defined_lines


def read_file_and_find_definitions(code):
    """
    Wrapper function to find variable/struct definitions and print results.
    Args:
        code (str): Filtered C code
    Returns:
        tuple: (set of defined variable/struct names, list of (line_num, line_content))
    """
    code_lines = code.splitlines()
    defined_vars, defined_lines = find_variable_definitions(code_lines)

    print("\nIdentified Variable/Struct Definitions:")
    for line_num, line in defined_lines:
        print(f"Line {line_num}: {line}")

    return defined_vars, defined_lines


def extract_function_calls_with_args(code_line):
    """
    Extract function calls and their arguments from a code line.
    Args:
        code_line (str): Single line of C code
    Returns:
        list: Tuples of (function_name, arguments_string)
    """
    func_call_pattern = re.compile(r'(\w+)\s*\(([^)]*)\)')
    return func_call_pattern.findall(code_line)


def find_used_variables_in_c_code(code_line, functions, defined_vars):
    """
    Identify variables used in a code line (excludes functions and keywords).
    Args:
        code_line (str): Single line of C code
        functions (list): Function details from identify_functions()
        defined_vars (set): Defined variable/struct names
    Returns:
        set: Used variable names
    """
    used_vars = set()
    function_names = {f['function_name'] for f in functions}

    # Remove string literals to avoid false matches
    code_line = re.sub(r'"[^"]*"', '', code_line)
    code_line = re.sub(r"'[^']*'", '', code_line)

    # Regex to match variables (supports pointers ->, array [], and struct .)
    var_pattern = r'\b([a-zA-Z_]\w*(?:->|\.|\*)?[a-zA-Z_]\w*(\[\d*\])?)\b'
    var_matches = re.findall(var_pattern, code_line)

    for match in var_matches:
        full_var = match[0]
        # Clean variable name (remove pointers, array indices, struct accessors)
        clean_var = re.sub(r'\*|->|\.|\[\d*\]', '', full_var).strip()
        # Exclude functions, defined variables, and unwanted keywords
        if (clean_var not in function_names and
                clean_var not in unwanted_keywords and
                clean_var not in defined_vars and
                clean_var):
            used_vars.add(full_var)
            used_vars.add(clean_var)

    return used_vars


def analyze_free_statement(statement):
    """
    Analyze code line for memory deallocation operations (free/delete).
    Args:
        statement (str): Single line of C code
    Returns:
        str: Formatted free operation string (e.g., "free ptr") or None
    """
    # Match free() calls
    free_pattern = r'free\s*\(\s*(\w+)\s*\);?'
    free_match = re.search(free_pattern, statement)
    if free_match:
        return f"free {free_match.group(1)}"

    # Match delete calls (supports array and single object)
    delete_pattern = r'delete\s*(?:\[\s*\])?\s*(\w+)\s*;?'
    delete_match = re.search(delete_pattern, statement)
    if delete_match:
        return f"free {delete_match.group(1)}"  # Align with paper's free representation

    return None


def extract_malloc_calls(code_string):
    """
    Extract memory allocation operations (malloc) from code.
    Args:
        code_string (str): C code (single line or multi-line)
    Returns:
        tuple: (list of "malloc" strings, list of allocated variable names)
    """
    # Match malloc with assignment (e.g., int *p = (int*)malloc(...))
    malloc_pattern = r'(\w+)\s*=\s*\(.*?\)\s*malloc\s*\((.*?)\)'
    matches = re.findall(malloc_pattern, code_string, re.DOTALL)

    processes = []
    variables = []
    for var_name, _ in matches:
        processes.append("malloc")
        variables.append(var_name.strip())

    return processes, variables


def extract_use_features(code):
    """
    Extract memory usage features (variable accesses) from code.
    Args:
        code (str): C code (single line or multi-line)
    Returns:
        list: Formatted use operation strings (e.g., "use ptr (line 5)")
    """
    use_features = []
    variable_id_map = {}
    next_id = 1

    # Regex patterns for variable usage (assignment, access, array access)
    use_patterns = [
        r'([a-zA-Z_]\w*)\s*=\s*.+;',  # Variable assignment (lhs)
        r'\w+\s*\(\s*&?([a-zA-Z_]\w*)\s*\);',  # Function argument (variable)
        r'([a-zA-Z_]\w*)\s*\[\s*.+\s*\]',  # Array access
        r'->([a-zA-Z_]\w*)',  # Pointer struct member access
        r'\.([a-zA-Z_]\w*)'  # Struct member access
    ]

    for line_num, line in enumerate(code.splitlines(), 1):
        stripped_line = line.strip()
        if not stripped_line or stripped_line.startswith(('#', '//')):
            continue

        # Check all usage patterns
        for pattern in use_patterns:
            matches = re.findall(pattern, stripped_line)
            for var_name in matches:
                if var_name and var_name not in unwanted_keywords:
                    if var_name not in variable_id_map:
                        variable_id_map[var_name] = f"data{next_id}"
                        next_id += 1
                    use_features.append(f"use {variable_id_map[var_name]} (line {line_num})")

    return use_features


# ========================= NEW: POINTER ALIAS TRACKING =========================
def track_pointer_aliases(statement, unwanted_keywords):
    """
    Track pointer alias relationships (core for UAF detection).
    Identifies: p2 = p1 (direct pointer alias), p2 = &p1 (reference alias)
    Returns: Formatted alias string (e.g., "alias p1 -> p2 (line 8)") or None
    """
    # Priority 1: Direct pointer alias (e.g., int *p2 = p1; or p2 = p1;)
    pointer_alias_pattern = r'(\*?[a-zA-Z_]\w*)\s*=\s*(\*?[a-zA-Z_]\w*)\s*;'
    # Priority 2: Reference alias (e.g., int *p2 = &p1;)
    ref_alias_pattern = r'([a-zA-Z_]\w*)\s*=\s*&\s*([a-zA-Z_]\w*)\s*;'

    # Check for pointer aliases first
    alias_match = re.search(pointer_alias_pattern, statement)
    if not alias_match:
        alias_match = re.search(ref_alias_pattern, statement)

    if alias_match:
        dest_ptr, src_ptr = alias_match.group(1), alias_match.group(2)
        # Filter out keywords and non-pointer variables
        if (dest_ptr not in unwanted_keywords and
                src_ptr not in unwanted_keywords and
                not dest_ptr.isdigit() and
                not src_ptr.isdigit()):
            # Return formatted alias string (compatible with draw_graph)
            return f"alias {src_ptr} -> {dest_ptr}"

    return None


